# ==========================================
# CAMPUS MARKETPLACE - FRONTEND ENVIRONMENT TEMPLATE
# ==========================================
# Copy this file to .env and fill in the values.
# DO NOT commit the actual .env file to version control!

# --- API CONNECTION ---
# Point this to your backend server URL (e.g., http://localhost:5000/api for local dev)
VITE_API_URL=http://localhost:5000/api

# --- AUTHENTICATION (GOOGLE OAUTH) ---
# Get this from: https://console.cloud.google.com/
# It must end in .apps.googleusercontent.com
VITE_GOOGLE_CLIENT_ID=your_google_client_id_here.apps.googleusercontent.com

# --- INTERNAL SECRETS ---
# This should match the ACCESS_TOKEN_SECRET in your backend/.env
# Used by the frontend for decoding or validating the access token if needed locally
ACCESS_TOKEN_SECRET=your_access_token_secret_here

# --- DEVELOPMENT / DEBUG ---
# Set to 'dev' to enable local-only UI states or testing bypasses (if supported)
VITE_APP_MODE=dev

# Set to 'true' to mock authentication states locally without Google Login
VITE_MOCK_AUTH=false
